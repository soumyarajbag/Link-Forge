APP_ENV=development
LOG_FORMAT=pretty
PORT=8080

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=linkforge

APP_URL=http://localhost:3000
API_URL=http://localhost:8080
SHORT_BASE_URL=http://localhost:8080
DEFAULT_SHORT_DOMAIN=localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

SESSION_TTL=168h
SESSION_IDLE_TTL=24h
# Local HTTP uses false. Production always forces secure cross-site cookies on.
COOKIE_SECURE=false
# Development only. Production always forces this off, regardless of the configured value.
EXPOSE_DEV_TOKENS=true
PASSWORD_MEMORY_KIB=65536
PASSWORD_ITERATIONS=3
PASSWORD_PARALLELISM=2

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
ANALYTICS_RETENTION_DAYS=90

# Email verification OTP delivery. Leave SMTP fields blank in development to
# log the OTP and expose it in the API response when EXPOSE_DEV_TOKENS=true.
EMAIL_FROM=LinkForge <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_VERIFICATION_TTL=15m
EMAIL_VERIFICATION_RESEND_COOLDOWN=60s

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
