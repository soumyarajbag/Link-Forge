{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 30, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index?route=/v1/:path*" },
    { "source": "/health", "destination": "/api/index?route=/health" },
    { "source": "/docs", "destination": "/api/index?route=/docs" },
    { "source": "/openapi.json", "destination": "/api/index?route=/openapi.json" },
    { "source": "/openapi.yaml", "destination": "/api/index?route=/openapi.yaml" },
    { "source": "/:slug", "destination": "/api/index?route=/r/:slug" }
  ]
}
